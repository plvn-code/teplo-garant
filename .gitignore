# ---------- dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- build output ----------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ---------- secrets: never commit ----------
# .env, .env.local, .env.production… (API keys, payment keys, DB URLs, Vercel OIDC token)
.env*
# …but a template with empty values is fine to share
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt

# ---------- hosting ----------
.vercel

# ---------- client archive / research (local only, heavy, not needed to run the site) ----------
/originals/
/research/

# ---------- logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---------- OS / editors / tools ----------
.DS_Store
Thumbs.db
.idea/
